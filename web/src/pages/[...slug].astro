---
import { loadQuery } from "../sanity/lib/load-query";
import Layout from "../layouts/Layout.astro";
import Block from "../components/Block.astro";

const { params } = Astro;

const { data: page } = await loadQuery<any>({
  query: `*[_type == "page" && slug.current == $slug][0] {
    ...,
    pageBuilder[] {
      ...,
      _type == "hero" => {
        ...,
        image { ..., asset-> },
        posterTall { ..., asset-> },
        video { asset->{ url } },
        videoSmall { asset->{ url } },
        videoTall { asset->{ url } }
      },
      _type == "people" => {
        ...,
        people[]->
      }
    }
  }`,
  params: {
    ...params,
    slug: params.slug || "index",
  },
  preview: Astro.locals.preview,
});

if (!page) {
  // Render the 404 page at the requested URL with a real 404 status (a redirect to /404 reads as a move).
  return Astro.rewrite("/404");
}

const blocks: any[] = page.pageBuilder ?? [];
const heroImage = blocks.find((b) => b._type === "hero")?.image?.asset?.url;
// Pages without a hero (e.g. Testimonials) would otherwise have no <h1>: promote the first text heading.
const h1Index = blocks.some((b) => b._type === "hero") ? -1 : blocks.findIndex((b) => b._type === "textSection" && b.heading);
---

<Layout title={page.title} fullTitle={page.seoTitle} description={page.description} ogImage={heroImage}>
  {blocks.map((block, i) => <Block {...block} headingLevel={i === h1Index ? 1 : 2} />)}
</Layout>
