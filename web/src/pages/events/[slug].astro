---
import { loadQuery } from "../../sanity/lib/load-query";
import { urlFor, srcset } from "../../sanity/lib/urlFor";
import { SITE, breadcrumb, eventNodes } from "../../lib/schema";
import { toHTML } from "@portabletext/to-html";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { keepCompounds } from "../../lib/text";
import {
  EVENT_FIELDS,
  formatAddress,
  fmtLong,
  futureSessions,
  lastSession,
  mapLink,
  metaDescription,
  monthGroups,
  nextSession,
  priceLabel,
  ranLabel,
  rangeLabel,
  repeatLabel,
  timeRange,
  type Event,
} from "../../lib/schedule";

const { slug } = Astro.params;

const { data: event } = await loadQuery<Event>({
  query: `*[_type == "event" && slug.current == $slug][0] { ${EVENT_FIELDS} }`,
  params: { slug },
  preview: Astro.locals.preview,
});

if (!event) {
  return Astro.rewrite("/404");
}

const next = nextSession(event);
const last = lastSession(event);
const future = futureSessions(event);
const LIMIT = 10;
const groupsFirst = monthGroups(future.slice(0, LIMIT), next);
const groupsRest = future.length > LIMIT ? monthGroups(future.slice(LIMIT), next) : [];
const repeat = repeatLabel(event);
const time = next ? timeRange(next.startTime, next.endTime) : (() => {
  const s = (event.sessions ?? []).find((x) => x.startTime);
  return s ? timeRange(s.startTime, s.endTime) : "";
})();

const image = event.photo?.asset ? event.photo : event.poster;
const imageSet = image?.asset ? srcset(image, 3 / 4, [400, 600, 800, 1040]) : undefined;
const address = formatAddress(event.venue);
const where = [event.venue?.name, address].filter(Boolean).join(", ");
const directions = mapLink(event.venue);
const isInstagram = !!event.link && /instagram\.com/.test(event.link);
const cta = next && event.link
  ? { href: event.link, label: isInstagram ? "Details on Instagram" : /eventbrite/.test(event.link) ? "Book free on Eventbrite" : "Book your place" }
  : { href: "https://instagram.com/our.movingstories", label: "Follow for new dates" };
const info = [
  ...(where ? [{ label: "Where", value: where }] : []),
  ...((event.info ?? []).filter((i) => i.label && i.value) as { label: string; value: string }[]),
];
if (!info.some((i) => /cost|price/i.test(i.label))) info.splice(where ? 1 : 0, 0, { label: "Cost", value: priceLabel(event.price) });
const description = event.description ? toHTML(event.description as any) : "";
const summary = event.summary || "";
const faqs = (event.faqs ?? []).filter((f) => f.question && f.answer);

// Event markup only while the event has dates to come; past-only pages are noindex and get the breadcrumb alone.
const pageUrl = new URL(Astro.url.pathname, SITE).href;
const ldImages = image?.asset
  ? ([[1600, 900], [1200, 900], [1200, 1200]] as const).map(([w, h]) => urlFor(image).width(w).height(h).fit("crop").url())
  : [];
const schema = [
  breadcrumb([{ name: "Home", path: "/" }, { name: "Events", path: "/events" }, { name: event.name, path: Astro.url.pathname }]),
  ...(next ? eventNodes(event, pageUrl, future, ldImages, metaDescription(event)) : []),
];
---

<!-- Events with no upcoming dates stay reachable (and their links followed) but leave search results
     and the sitemap: a "No upcoming dates" page is a dead end for someone searching for a session. -->
<Layout
  title={event.name}
  description={metaDescription(event)}
  ogImage={image?.asset ? urlFor(image).width(1200).height(630).fit("crop").url() : undefined}
  noindex={!next}
  schema={schema}
>
  <section class="wrap pt-7 pb-20 md:pb-[88px]">
    <a href="/events" class="label inline-flex items-center gap-[0.6em] py-3 text-ink no-underline mb-6 hover:text-grape"><Icon name="arrow-left" />All events</a>

    <div class="grid gap-x-16 gap-y-12 items-start md:grid-cols-2">
      <div>
        <div class="flex gap-2 flex-wrap mb-[22px]">
          {event.audience && <span class="tag" set:html={keepCompounds(event.audience)} />}
          <span class="tag">{repeat.short}</span>
          <span class="tag bg-grape border-grape text-cream">{priceLabel(event.price)}</span>
        </div>
        {/* Heading size, not title: the name shares a column with the poster and is often long
            ("Move and Make @ Open Havelock - 2026/27"), and the booking button has to stay in the first screen. */}
        <h1 class="display text-heading text-grape mb-6">{event.name}</h1>
        {summary && <p class="text-lead max-w-[30em] mb-9" set:html={keepCompounds(summary)} />}

        <div class="border-t-[3px] border-ink border-b-[1.5px] pt-5 pb-6 mb-7">
          {next ? (
            <>
              <div class="eyebrow text-grape mb-2">Next date</div>
              <div class="display text-sub text-coral">{fmtLong(next.date)}</div>
              <div class="text-lead mt-2.5">{time}{event.venue?.name ? ` · ${event.venue.name}` : ""}</div>
              {next.note && <div class="text-small mt-1">{next.note}</div>}
            </>
          ) : (
            <>
              <div class="eyebrow text-grape mb-2">{last ? "Past event" : "No dates yet"}</div>
              <div class="display text-sub">{last ? ranLabel(event) : "Dates to be announced"}</div>
              <div class="text-body mt-2.5">New dates are announced on Instagram and in the newsletter.</div>
            </>
          )}
        </div>

        <div class="flex gap-3 flex-wrap">
          <a href={cta.href} target="_blank" rel="noopener noreferrer" class="btn-primary">{cta.label}<Icon name="arrow-up-right" /></a>
          {directions && <a href={directions} target="_blank" rel="noopener noreferrer" class="btn-outline">Directions<Icon name="arrow-up-right" /></a>}
        </div>
      </div>

      {imageSet && (
        <div class="relative pt-[18px] pr-[18px] max-w-[540px]">
          <div class="absolute top-0 right-0 w-[88%] h-[92%] bg-coral rotate-2"></div>
          <div class="relative aspect-3/4 overflow-hidden bg-sand rotate-[-1.5deg]">
            <img {...imageSet} sizes="(min-width: 768px) 522px, calc(100vw - 58px)" alt={event.name} class="w-full h-full object-cover block" width="520" height="693" fetchpriority="high" />
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="bg-grape text-cream on-dark">
    <div class="wrap pt-20 pb-[88px] grid gap-x-16 gap-y-14 items-start md:grid-cols-2">
      <div>
        <div class="eyebrow text-coral-light mb-[18px]">About this event</div>
        {description && <div class="rich text-prose mb-9 [&_a]:text-cream [&_a:hover]:text-coral-light" set:html={description} />}
        <div class="border-t-2 border-cream">
          {info.map((row) => (
            <div class="grid grid-cols-[120px_minmax(0,1fr)] sm:grid-cols-[150px_minmax(0,1fr)] gap-4 py-3.5 border-b-[1.5px] border-dashed border-lilac-dash text-body">
              <span class="label text-coral-light pt-[2px]">{row.label}</span>
              <span>{row.value}</span>
            </div>
          ))}
        </div>
        {faqs.length > 0 && (
          <>
            <h2 class="eyebrow text-coral-light mt-14 mb-[18px]">Questions</h2>
            <dl class="border-t-2 border-cream">
              {faqs.map((f) => (
                <div class="py-4 border-b-[1.5px] border-dashed border-lilac-dash">
                  <dt class="font-bold text-prose leading-snug mb-1.5">{f.question}</dt>
                  <dd class="text-body leading-relaxed whitespace-pre-line">{f.answer}</dd>
                </div>
              ))}
            </dl>
          </>
        )}
      </div>

      <div x-data="{ all: false }">
        <div class="eyebrow text-coral-light mb-[18px]">Schedule</div>
        <div class="display text-sub mb-2">{repeat.long}</div>
        <div class="text-body text-lilac mb-[30px]">{[time, rangeLabel(event)].filter(Boolean).join(" · ")}</div>

        {future.length > 0 ? (
          <>
            {[groupsFirst, groupsRest].map((groups, gi) => (
              <div class="flex flex-col gap-[22px]" x-show={gi === 1 ? "all" : undefined} x-cloak={gi === 1 ? true : undefined} style={gi === 1 ? "margin-top: 22px" : undefined}>
                {groups.map((m) => (
                  <div>
                    <div class="label pb-2 border-b-[1.5px] border-lilac-dash mb-2.5">{m.label}</div>
                    <div class="flex flex-wrap gap-2">
                      {m.dates.map((d) =>
                        d.state === "next" ? (
                          <span class="label px-[11px] py-2 bg-coral text-ink border-[1.5px] border-coral">{d.label} · next</span>
                        ) : d.state === "off" ? (
                          <span title={d.note} class="label px-[11px] py-2 border-[1.5px] border-dashed border-lilac-mid text-lilac-light line-through"><span class="sr-only">Cancelled: </span>{d.label}</span>
                        ) : (
                          <span class="label px-[11px] py-2 border-[1.5px] border-lilac">{d.label}</span>
                        )
                      )}
                    </div>
                    {m.note && <div class="text-small text-lilac-light mt-2">{m.note}</div>}
                  </div>
                ))}
              </div>
            ))}
            {groupsRest.length > 0 && (
              <button type="button" @click="all = !all" class="mt-6 btn-outline-light py-[11px] px-4">
                <span x-text={`all ? 'Show fewer dates' : 'Show all ${future.length} dates'`}>Show all {future.length} dates</span>
              </button>
            )}
          </>
        ) : (
          <p class="text-body text-lilac">No dates scheduled at the moment.</p>
        )}
      </div>
    </div>
  </section>
</Layout>
