---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" noindex>
  <section class="wrap pt-16 md:pt-24 pb-24 md:pb-32">
    <div class="eyebrow text-grape mb-4">
      <img src="/img/leaves/leaf-1.svg" alt="" aria-hidden="true" style="transform: rotate(30deg)" />404
    </div>
    <h1 class="display text-[clamp(64px,11vw,176px)] leading-[0.82] text-grape mb-8">Wrong <span class="text-coral">turn.</span></h1>
    <p class="text-[21px] leading-[1.45] max-w-[30em] mb-9">This page has moved or never existed. Try what's on, or head back to the homepage.</p>
    <div class="flex gap-3 flex-wrap">
      <a href="/#whats-on" class="btn-primary">See what's on</a>
      <a href="/" class="btn-outline">Homepage</a>
    </div>
  </section>
</Layout>
