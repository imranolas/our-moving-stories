---
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";
import { stegaClean } from "@sanity/client/stega";
import SanityVisualEditing from "../components/SanityVisualEditing";
import { siteData } from "../lib/data";
import { SITE, ldJson, organizationNode, websiteNode, type Json } from "../lib/schema";

interface Props {
  title: string;
  /** Use this exact <title>, without the " · Our Moving Stories" suffix (e.g. the homepage's SEO title). */
  fullTitle?: string;
  description?: string;
  ogImage?: string;
  /** Keep the page out of search results. It stays reachable and its links are still followed. */
  noindex?: boolean;
  /** The page's own JSON-LD nodes (src/lib/schema.ts), added to the organisation and website nodes. */
  schema?: Json[];
  /** @deprecated The header is always solid now; kept so older callers still compile. */
  transparentNav?: boolean;
}

const props = Astro.props;
// In draft mode Sanity strings carry invisible stega markers; keep them out of <head>.
const title = stegaClean(props.title);
const fullTitleOverride = stegaClean(props.fullTitle);
const ogImage = stegaClean(props.ogImage);
const noindex = props.noindex ?? false;
const description = stegaClean(props.description) || "Free community dance, art and movement sessions for families in West London. Explore movement, make art, and connect through creativity with Our Moving Stories.";
// Canonical URLs have no trailing slash (src/middleware.ts redirects slash URLs to match).
const canonicalUrl = new URL(Astro.url.pathname.replace(/(.)\/+$/, "$1"), SITE);
const fullTitle =
  fullTitleOverride?.trim() ||
  (title && title !== "Our Moving Stories" ? `${title} · Our Moving Stories` : "Our Moving Stories");
// 1200×630 crop of the hero poster, used wherever a page has no image of its own.
const ogImageUrl = new URL(ogImage || "/img/og-default.jpg", SITE).href;

// Settings, nav and footer: one query, started by the middleware before the page rendered.
const site = await siteData(Astro.locals);
const graph = { "@context": "https://schema.org", "@graph": [organizationNode(site.settings), websiteNode(), ...(props.schema ?? [])] };

// Cloudflare Web Analytics (no cookies, so no consent banner). Set the site token from the dashboard in the
// build environment to turn it on; see docs/redesign/HANDOFF.md → Analytics. Never counted in draft mode.
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN as string | undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F3EDE2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalUrl.href} />}
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-big-shoulders" preload />
    <Font cssVariable="--font-karla" preload />
    <Font cssVariable="--font-dm-mono" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content="Our Moving Stories" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={ldJson(graph)} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-200 bg-ink text-cream px-4 py-2 font-mono text-sm uppercase">Skip to content</a>
    <Nav site={site} />
    <main id="main">
      <slot />
    </main>
    <Footer site={site} />
    {Astro.locals.preview && <SanityVisualEditing client:only="react" />}
    {analyticsToken && !Astro.locals.preview && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
  </body>
</html>

<script>
  // Alpine, bundled with the site (it used to load from a CDN). Module scripts run after the HTML is parsed,
  // like the old `defer` tag, so x-cloak and the components behave the same.
  import Alpine from "alpinejs";
  (window as any).Alpine = Alpine;
  Alpine.start();
</script>
