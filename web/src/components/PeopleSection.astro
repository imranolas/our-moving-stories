---
import { srcset } from "../sanity/lib/urlFor";
import { toHTML } from "@portabletext/to-html";
import type { PortableTextBlock } from "@portabletext/types";
import { highlight, leaf } from "../lib/text";
import { stegaClean } from "@sanity/client/stega";

export type Props = {
  _type: "people";
  _key: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  people: {
    name: string;
    role?: string;
    excerpt?: string;
    slug?: { current: string };
    profile?: any;
    bio?: PortableTextBlock[];
  }[];
};

const { eyebrow = "The people", title = "A small, *mighty* team", description } = Astro.props;
// `people[]->` comes back null (not undefined) when the section has no people.
const people = Astro.props.people ?? [];

const plain = (bio?: PortableTextBlock[]) => {
  // A truncated excerpt can't keep stega (draft mode) intact, so drop it.
  const text = bio ? stegaClean(toHTML(bio)).replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim() : "";
  return text.length > 200 ? text.slice(0, 197).replace(/\s+\S*$/, "") + "…" : text;
};
---

<section id="people" class="border-t-[3px] border-ink">
  <div class="wrap py-20 md:py-24">
    <div class="flex items-end justify-between gap-6 flex-wrap mb-11">
      <div>
        <div class="eyebrow text-grape mb-3.5">
          <img src="/img/leaves/leaf-2.svg" alt="" aria-hidden="true" style="transform: rotate(20deg)" />{eyebrow}
        </div>
        <h2 class="display text-[clamp(56px,8vw,124px)] leading-[0.82] text-grape" set:html={highlight(title)} />
      </div>
      {description && <p class="text-[17px] leading-normal max-w-[21em]">{description}</p>}
    </div>

    <ul class="grid gap-x-6 gap-y-10 items-start grid-cols-[repeat(auto-fill,minmax(min(100%,230px),1fr))] border-t-[3px] border-ink pt-7">
      {people.filter(Boolean).map((p, i) => {
        const l = leaf(i);
        const href = p.slug?.current ? `/people/${p.slug.current}` : undefined;
        const Tag = href ? "a" : "div";
        return (
          <li>
            <Tag href={href} class="group block text-ink no-underline hover:text-ink">
              <div class="relative">
                <div class="aspect-4/5 overflow-hidden bg-lilac-mid">
                  {p.profile?.asset && (
                    <img
                      {...srcset(p.profile, 4 / 5, [300, 450, 600, 900])}
                      sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, calc(100vw - 40px)"
                      alt={p.name}
                      class="w-full h-full object-cover block grayscale contrast-[1.15] mix-blend-multiply transition-[filter] duration-300 group-hover:grayscale-0 group-hover:mix-blend-normal"
                      loading="lazy"
                      width="600"
                      height="750"
                    />
                  )}
                </div>
                <img src={l.src} alt="" aria-hidden="true" class="absolute top-[-18px] right-2.5 h-[52px] w-auto" style={`transform: rotate(${l.rot}deg)`} />
              </div>
              <h3 class="display text-[34px] leading-[0.9] mt-[18px] mb-1.5 group-hover:text-grape">{p.name}</h3>
              {p.role && <div class="font-mono text-xs uppercase tracking-[0.04em] text-grape mb-2.5">{p.role}</div>}
              <p class="text-[15px] leading-[1.55]">{p.excerpt || plain(p.bio)}</p>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>
