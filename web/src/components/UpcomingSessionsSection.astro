---
import { allEvents } from "../lib/data";
import { highlight } from "../lib/text";
import { eventHref, fmtShort, parseDate, timeRange, todayISO } from "../lib/schedule";
import Icon from "./Icon.astro";

export type Props = {
  _type: "upcomingSessions";
  _key: string;
  eyebrow?: string;
  title?: string;
  limit?: number;
};

const { eyebrow = "Diary", title = "This week", limit = 8 } = Astro.props;

const today = todayISO();

// Only the coming week (today and the six days after): "Coming up" above already lists every event, so this is
// the short "what can we do this week" answer rather than a second listing. With nothing on this week the
// section hides; the full timetable is at /sessions.
const weekEnd = (() => {
  const d = parseDate(today);
  d.setDate(d.getDate() + 6);
  return [d.getFullYear(), String(d.getMonth() + 1).padStart(2, "0"), String(d.getDate()).padStart(2, "0")].join("-");
})();

const rows = (await allEvents(Astro.locals))
  .flatMap((e) =>
    (e.sessions ?? [])
      .filter((s) => !s.cancelled && s.date >= today && s.date <= weekEnd)
      .map((s) => ({ ...s, event: e }))
  )
  .sort((a, b) => a.date.localeCompare(b.date) || (a.startTime ?? "").localeCompare(b.startTime ?? ""))
  .slice(0, limit);

function relative(date: string) {
  const days = Math.round((parseDate(date).getTime() - parseDate(today).getTime()) / 86400000);
  if (days === 0) return "Today";
  if (days === 1) return "Tomorrow";
  return fmtShort(date);
}
---

{rows.length > 0 && (
  <section class="border-t-[3px] border-ink">
    <div class="wrap py-20 md:py-24">
      <div class="eyebrow text-grape mb-3.5">
        <img src="/img/leaves/leaf-5.svg" alt="" aria-hidden="true" style="transform: rotate(18deg)" />{eyebrow}
      </div>
      <h2 class="display text-heading text-grape mb-9" set:html={highlight(title)} />
      <ul class="border-t-[3px] border-ink">
        {rows.map((r) => (
          <li>
            <a href={eventHref(r.event)} class="grid grid-cols-[minmax(0,1fr)] sm:grid-cols-[180px_170px_minmax(0,1fr)_auto] gap-x-6 gap-y-1 items-baseline py-4 border-b-[1.5px] border-ink text-ink no-underline row-hover">
              <time datetime={r.startTime ? `${r.date}T${r.startTime}` : r.date} class="display text-item text-grape">{relative(r.date)}</time>
              <span class="text-body">{timeRange(r.startTime, r.endTime)}</span>
              <span class="text-lead font-bold leading-tight">{r.event.name}{r.note && <span class="block font-normal text-small text-ink/70 mt-0.5">{r.note}</span>}</span>
              <span class="text-body">{r.event.venue?.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/sessions" class="label inline-flex items-center gap-[0.6em] mt-3.5 py-3 text-ink hover:text-grape">All sessions<Icon name="arrow-right" /></a>
    </div>
  </section>
)}
