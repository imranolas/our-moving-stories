---
import { loadQuery } from "../sanity/lib/load-query";
import { highlight } from "../lib/text";
import { EVENT_FIELDS, eventHref, fmtShort, parseDate, timeRange, todayISO, type Event } from "../lib/schedule";

export type Props = {
  _type: "upcomingSessions";
  _key: string;
  eyebrow?: string;
  title?: string;
  limit?: number;
};

const { eyebrow = "Diary", title = "Upcoming sessions", limit = 8 } = Astro.props;

const { data } = await loadQuery<Event[]>({ query: `*[_type == "event"]{ ${EVENT_FIELDS} }`, preview: Astro.locals.preview });
const today = todayISO();

const rows = (data ?? [])
  .flatMap((e) =>
    (e.sessions ?? [])
      .filter((s) => !s.cancelled && s.date >= today)
      .map((s) => ({ ...s, event: e }))
  )
  .sort((a, b) => a.date.localeCompare(b.date) || (a.startTime ?? "").localeCompare(b.startTime ?? ""))
  .slice(0, limit);

function relative(date: string) {
  const days = Math.round((parseDate(date).getTime() - parseDate(today).getTime()) / 86400000);
  if (days === 0) return "Today";
  if (days === 1) return "Tomorrow";
  return fmtShort(date);
}
---

{rows.length > 0 && (
  <section class="border-t-[3px] border-ink">
    <div class="wrap py-20 md:py-24">
      <div class="eyebrow text-grape mb-3.5">
        <img src="/img/leaves/leaf-5.svg" alt="" aria-hidden="true" style="transform: rotate(18deg)" />{eyebrow}
      </div>
      <h2 class="display text-[clamp(48px,7vw,104px)] leading-[0.84] text-grape mb-9" set:html={highlight(title)} />
      <ul class="border-t-[3px] border-ink">
        {rows.map((r) => (
          <li>
            <a href={eventHref(r.event)} class="grid grid-cols-[minmax(0,1fr)] sm:grid-cols-[180px_170px_minmax(0,1fr)_auto] gap-x-6 gap-y-1 items-baseline py-4 border-b-[1.5px] border-ink text-ink no-underline hover:bg-peach hover:px-4 transition-all duration-150">
              <span class="display text-[28px] leading-none text-grape">{relative(r.date)}</span>
              <span class="font-mono text-[13px] uppercase">{timeRange(r.startTime, r.endTime)}</span>
              <span class="text-[19px] font-bold leading-tight">{r.event.name}{r.note && <span class="block font-normal text-[15px] text-ink/70">{r.note}</span>}</span>
              <span class="font-mono text-[13px]">{r.event.venue?.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/sessions" class="inline-block mt-[26px] font-mono text-[13px] uppercase text-ink hover:text-grape">All sessions →</a>
    </div>
  </section>
)}
