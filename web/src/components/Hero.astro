---
import { urlFor } from "../sanity/lib/urlFor";
import { allEvents } from "../lib/data";
import { highlight, keepCompounds, splitHighlight } from "../lib/text";
import { stegaClean } from "@sanity/client/stega";
import { bookingLink, eventHref, fmtShort, nextSession, splitEvents, timeRange } from "../lib/schedule";
import Icon from "./Icon.astro";

type SanityFile = { asset?: { url?: string } };

export type Props = {
  _type: "hero";
  _key: string;
  kicker?: string;
  title: string;
  subtitle?: string;
  image?: any;
  posterTall?: any;
  video?: SanityFile;
  videoSmall?: SanityFile;
  videoTall?: SanityFile;
  videoDescription?: string;
  overlayStrength?: number;
  badge?: string;
  badgeRing?: string;
  cta?: { title?: string; link?: string };
  showNextUp?: boolean;
};

const {
  kicker,
  title,
  subtitle,
  image,
  posterTall,
  video,
  videoSmall,
  videoTall,
  videoDescription,
  overlayStrength,
  badge = "Free",
  badgeRing = "All ages · All abilities · Free · ",
  cta,
  showNextUp = true,
} = Astro.props;

const isHome = Astro.url.pathname === "/";
const uploadedVideo = video?.asset?.url;
// The homepage falls back to the montage bundled with the site.
const useVideo = !!uploadedVideo || (!image?.asset && isHome);
const sources = {
  wide: uploadedVideo || "/video/hero-wide.mp4",
  small: videoSmall?.asset?.url || (uploadedVideo ? uploadedVideo : "/video/hero-wide-720.mp4"),
  tall: videoTall?.asset?.url || (uploadedVideo ? "" : "/video/hero-tall.mp4"),
};
// Posters: a WebP copy sits next to each bundled JPEG; Sanity serves AVIF/WebP itself (auto("format")).
type Poster = { src: string; webp?: string };
const posterWide: Poster | undefined = image?.asset
  ? { src: urlFor(image).width(1920).height(1080).auto("format").url() }
  : useVideo && !uploadedVideo
    ? { src: "/video/hero-wide-poster.jpg", webp: "/video/hero-wide-poster.webp" }
    : undefined;
const posterNarrow: Poster | undefined = posterTall?.asset
  ? { src: urlFor(posterTall).width(1080).height(1920).auto("format").url() }
  : !uploadedVideo
    ? { src: "/video/hero-tall-poster.jpg", webp: "/video/hero-tall-poster.webp" }
    : posterWide;
const firstPoster = posterWide ?? posterNarrow;
const objectPosition = image?.hotspot
  ? `${(image.hotspot.x * 100).toFixed(1)}% ${(image.hotspot.y * 100).toFixed(1)}%`
  : "center";
const hasMedia = useVideo || !!image?.asset;


const k = (overlayStrength ?? 60) / 60;
const a = (x: number) => Math.min(1, x * k).toFixed(2);
// Softer than it was (0.9 / 0.68 / 0.56): with the smaller title the footage needs less darkening, and the
// title and kicker carry their own text shadows on light frames.
const overlay = `linear-gradient(to top, rgba(30,20,51,${a(0.78)}) 0%, rgba(30,20,51,${a(0.5)}) 34%, rgba(30,20,51,0) 62%), linear-gradient(to right, rgba(30,20,51,${a(0.42)}) 0%, rgba(30,20,51,0) 58%)`;

const { lead, joiner, accent } = splitHighlight(title);
// The title is the hero's peak but leaves the footage room: the lead runs 34–68px and the accent line
// ("& movement.") up to 10vw (150px), about two-thirds of the size they were. The accent is as wide as the
// heading allows: Big Shoulders Display capitals average under 0.5em each, so N characters fit in N × 0.5em of
// the heading's width (100cqi; the h1 is a size container). On phones, where 10vw is smaller than the lead, it
// fills the width instead (up to 64px), keeping the jump from the 34px lead clear. Text longer than that wraps.
const accentChars = stegaClean(accent).length + (joiner ? joiner.length + 1 : 0);
const accentSize = accent && `max(34px, min(100cqi / ${accentChars * 0.5}, max(10vw, 64px), 150px))`;

// The soonest session across all events: "Next up", and whether there's anything to book.
const first = splitEvents(await allEvents(Astro.locals)).upcoming[0];
const firstSession = first && nextSession(first);
let nextUp: { title: string; href: string; date: string; time: string; venue?: string; book: ReturnType<typeof bookingLink> } | null = null;
if (showNextUp && first && firstSession) {
  nextUp = { title: first.name, href: eventHref(first), date: fmtShort(firstSession.date), time: timeRange(firstSession.startTime, firstSession.endTime), venue: first.venue?.name, book: bookingLink(first) };
}

const SWASH = "M203.449 626.485C203.449 626.485 222.534 651.302 222.534 651.302C285.515 626.485 509.738 598.589 662.547 607.713C662.547 600.629 642.881 587.582 642.881 587.582C615.398 577.572 264.493 601.162 203.449 626.485Z";
---

{hasMedia ? (
  <section id="top" class="on-dark relative h-[calc(100svh-64px)] md:h-[calc(100svh-80px)] min-h-[560px] max-h-[1080px] overflow-hidden bg-ink text-cream">
    {useVideo ? (
      <>
        {/* The poster is a <picture> under the video rather than its `poster` attribute: each screen shape
            downloads only its own poster, the preload scanner finds it, and it's the LCP image. The video
            stays transparent until it has a frame to show. */}
        {firstPoster && (
          <picture>
            {posterNarrow && posterNarrow !== posterWide && posterNarrow.webp && <source media="(max-aspect-ratio: 4/5)" srcset={posterNarrow.webp} type="image/webp" />}
            {posterNarrow && posterNarrow !== posterWide && <source media="(max-aspect-ratio: 4/5)" srcset={posterNarrow.src} />}
            {firstPoster.webp && <source srcset={firstPoster.webp} type="image/webp" />}
            <img src={firstPoster.src} alt="" class="absolute inset-0 w-full h-full object-cover" fetchpriority="high" />
          </picture>
        )}
      <video
        data-hero-video
        data-preview-keep="data-wide data-small data-tall"
        data-wide={sources.wide}
        data-small={sources.small}
        data-tall={sources.tall}
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={videoDescription || "Montage filmed at our sessions"}
        class="absolute inset-0 w-full h-full object-cover block"
      ></video>
      </>
    ) : (
      <img src={posterWide?.src} alt="" class="absolute inset-0 w-full h-full object-cover" style={`object-position: ${objectPosition}`} loading="eager" fetchpriority="high" />
    )}
    <div aria-hidden="true" class="absolute inset-0" style={`background: ${overlay}`}></div>

    {/* Badge: at least 220px wide so the ring text stays readable on phones; its text scales with it (cqi). */}
    {badge && (
      <div class="absolute top-4 right-3 z-2 w-[clamp(220px,calc(160px_+_18vw),400px)] aspect-3/2 [container-type:inline-size] pointer-events-none" aria-hidden="true">
        <img src="/img/leaves/wing-left.svg" alt="" class="absolute left-0 top-0 w-[52%] h-auto origin-[92%_88%] rotate-[-8deg]" />
        <img src="/img/leaves/wing-right.svg" alt="" class="absolute right-0 top-0 w-[52%] h-auto origin-[8%_88%] rotate-[8deg]" />
        <div class="absolute left-1/2 top-[56%] w-[42%] aspect-square rounded-full bg-cream border-2 border-ink flex items-center justify-center -translate-x-1/2 -translate-y-1/2 rotate-[-8deg]">
          <div class="absolute inset-[5px] animate-oms-spin">
            <svg viewBox="0 0 100 100" width="100%" height="100%">
              <defs><path id="omsCirc" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs>
              <text style="font-size: 9.6px; letter-spacing: 1.3px;" class="font-mono uppercase fill-ink"><textPath href="#omsCirc">{badgeRing}</textPath></text>
            </svg>
          </div>
          <span class="display text-grape text-[length:9.5cqi]">{badge}</span>
        </div>
      </div>
    )}

    <div class="relative z-1 h-full wrap py-8 flex flex-col justify-end">
      {/* A middle dot stays with the word before it, so no line starts with "·". */}
      {kicker && <div class="eyebrow mb-[18px] text-cream [text-shadow:0_1px_12px_rgba(30,20,51,0.9),0_0_2px_rgba(30,20,51,0.8)]">{kicker.replace(/ · /g, "\u00a0· ")}</div>}
      <h1 class="display text-cream [container-type:inline-size] [text-shadow:0_2px_24px_rgba(30,20,51,0.35)]">
        <span class="block text-[clamp(34px,4.5vw,68px)] max-w-[11.5em]">{lead}</span>
        {accent && (
          <span class="block mt-[0.04em] tracking-[-0.005em]" style={`font-size: ${accentSize}; line-height: 0.86`}>
            {joiner && `${joiner}\u00a0`}
            <span class="inline-block text-coral">
              {accent}
              <svg aria-hidden="true" viewBox="200 574 466 80" preserveAspectRatio="none" class="block w-[94%] h-[0.12em] mt-[0.03em] ml-[3%] overflow-visible">
                <path d={SWASH} class="fill-cream" />
              </svg>
            </span>
          </span>
        )}
      </h1>
      {/* The page's main action, inside the first screen on phones too. Only when there's something to book. */}
      {/* It leads to the list, not to a booking, so it says "find". */}
      {firstSession && <a href="/#whats-on" class="btn-coral self-start mt-7">Find a free session<Icon name="arrow-right" /></a>}
      <div class="flex justify-between items-center gap-3 flex-wrap mt-[22px]">
        <a href="https://instagram.com/our.movingstories" target="_blank" rel="noopener noreferrer" class="label inline-flex items-center gap-[0.5em] py-3 text-cream hover:text-coral-soft">@our.movingstories<Icon name="arrow-up-right" /></a>
        {useVideo && (
          <button type="button" data-hero-toggle data-preview-keep class="label inline-flex items-center gap-[0.6em] min-h-11 bg-transparent text-cream px-3.5 py-2 border-2 border-cream hover:bg-cream hover:text-ink" aria-label="Pause the video">
            <span data-when="playing" class="inline-flex items-center gap-[0.6em]"><Icon name="pause" />Pause</span>
            <span data-when="paused" class="hidden items-center gap-[0.6em]"><Icon name="play" />Play</span>
          </button>
        )}
      </div>
    </div>
  </section>
) : (
  <section id="top" class="wrap pt-14 md:pt-20 pb-6">
    {kicker && <div class="eyebrow text-grape mb-4">{kicker}</div>}
    <h1 class="display text-title text-grape" set:html={highlight(title)} />
  </section>
)}

{(subtitle || nextUp) && (
  <section class="wrap pt-12 pb-4 md:pb-6">
    {/* Two columns: the intro with its button under it, then Next up. A short bottom padding: the next section
        (usually Coming up, on the same cream) brings its own top space, and the two together read as one gap. */}
    <div class="grid gap-x-16 gap-y-10 items-end md:grid-cols-2">
      <div>
        {subtitle && <p class="text-lead text-pretty max-w-[30em]" set:html={keepCompounds(subtitle)} />}
        {/* "See what's on" used to sit here too: the hero button and the nav already go there. */}
        <div class="flex gap-3 flex-wrap mt-6">
          {cta?.title && cta?.link ? (
            <a href={cta.link} class="btn-outline">{cta.title}</a>
          ) : (
            <a href="#contact" class="btn-outline">Newsletter</a>
          )}
        </div>
      </div>
      {nextUp && (
        <div class="border-t-2 border-ink pt-3.5">
          <div class="eyebrow text-grape mb-2">Next up · {nextUp.date}</div>
          {/* The no-break space keeps the arrow with the last word when the name wraps. */}
          <a href={nextUp.href} class="block display text-item text-ink no-underline hover:text-grape">{nextUp.title}<span class="whitespace-nowrap">&nbsp;<Icon name="arrow-right" weight={3} /></span></a>
          <div class="text-body mt-1.5">{nextUp.time}{nextUp.venue ? ` · ${nextUp.venue}` : ""}</div>
          {/* Booking is the job: the soonest session can be booked from here, one step. */}
          {nextUp.book && <a href={nextUp.book.href} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4">{nextUp.book.label}<Icon name="arrow-up-right" /></a>}
        </div>
      )}
    </div>
  </section>
)}

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-toggle]");
  if (video) {
    const conn = (navigator as any).connection;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Save-Data or 2G: show the poster and only download the video if Play is pressed.
    const lite = !!(conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || "")));
    const tallQuery = window.matchMedia("(max-aspect-ratio: 4/5)");
    let paused = reduce || lite;
    // Nothing is downloaded until a source is set; reduced motion and lite connections wait for Play.
    let wanted = !paused;

    const setLabel = () => {
      if (!toggle) return;
      // Both labels (with their icons) are in the button; show the one that applies.
      toggle.querySelectorAll<HTMLElement>("[data-when]").forEach((el) => {
        const show = (el.dataset.when === "paused") === paused;
        el.classList.toggle("hidden", !show);
        el.classList.toggle("inline-flex", show);
      });
      toggle.setAttribute("aria-label", paused ? "Play the video" : "Pause the video");
    };

    const pick = () => {
      if (!wanted) return;
      const d = video.dataset;
      const small =
        window.innerWidth * (window.devicePixelRatio || 1) <= 1400 || /(^|-)3g$/.test(conn?.effectiveType || "");
      const tall = tallQuery.matches && !!d.tall;
      const src = tall ? d.tall! : small ? d.small! : d.wide!;
      if (video.dataset.current !== src) {
        video.dataset.current = src;
        video.src = src;
      }
      if (!paused) video.play().catch(() => { paused = true; setLabel(); });
    };

    video.muted = true;
    pick();
    setLabel();
    tallQuery.addEventListener?.("change", pick);
    toggle?.addEventListener("click", () => {
      if (video.paused) {
        paused = false;
        wanted = true;
        pick();
      } else {
        paused = true;
        video.pause();
      }
      setLabel();
    });
  }
</script>
