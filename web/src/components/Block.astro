---
import Hero, { type Props as HeroProps } from "./Hero.astro";
import TextSection, {
  type Props as TextSectionProps,
} from "./TextSection.astro";
import PeopleSection, {
  type Props as PeopleSectionProps,
} from "./PeopleSection.astro";
import InstagramSection, {
  type Props as InstagramSectionProps,
} from "./InstagramSection.astro";
import EventsSection, {
  type Props as EventsSectionProps,
} from "./EventsSection.astro";
import UpcomingSessionsSection, {
  type Props as UpcomingSessionsSectionProps,
} from "./UpcomingSessionsSection.astro";

type Props =
  | HeroProps
  | TextSectionProps
  | PeopleSectionProps
  | EventsSectionProps
  | UpcomingSessionsSectionProps
  | InstagramSectionProps;

const typeMap: Record<string, any> = {
  hero: Hero,
  textSection: TextSection,
  people: PeopleSection,
  events: EventsSection,
  upcomingSessions: UpcomingSessionsSection,
  instagram: InstagramSection,
};

const Element = typeMap[Astro.props._type] || "div";
const props = Astro.props;
---

<Element {...(props as any)} />
