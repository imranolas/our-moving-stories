---
import { type PortableTextBlock } from "@portabletext/types";
import { toHTML } from "@portabletext/to-html";
import { highlight, leaf } from "../lib/text";

export type Props = {
  _type: "textSection";
  _key: string;
  eyebrow?: string;
  heading: string;
  excerpt?: PortableTextBlock[];
  anchorId?: { current: string };
  theme?: "cream" | "purple" | "dark";
  layout?: "split" | "stacked";
  pillars?: { _key?: string; title?: string; text?: string; accent?: boolean }[];
  /** 1 when this heading is the page's main heading (pages without a hero); set by [...slug].astro. */
  headingLevel?: 1 | 2;
};

const { eyebrow, heading, excerpt, anchorId, theme = "cream", pillars = [], headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";
const layout = Astro.props.layout ?? (pillars.length ? "split" : "stacked");
const html = excerpt ? toHTML(excerpt) : "";

const themes = {
  cream: { section: "bg-cream text-ink", eyebrow: "text-grape", heading: "text-grape", body: "", muted: "text-ink/70", rule: "border-ink", dash: "border-ink/40" },
  purple: { section: "bg-grape text-cream", eyebrow: "text-coral-soft", heading: "text-cream", body: "[&_p:not(:first-child)]:text-lilac", muted: "text-lilac", rule: "border-cream", dash: "border-lilac-dash" },
  dark: { section: "bg-ink text-cream", eyebrow: "text-coral-soft", heading: "text-cream", body: "[&_p:not(:first-child)]:text-lilac", muted: "text-lilac", rule: "border-cream", dash: "border-mauve-line" },
};
const t = themes[theme] ?? themes.cream;
const decor = leaf(heading?.length ?? 0);
---

<section id={anchorId?.current} class={t.section}>
  <div class="wrap py-20 md:py-24">
    {layout === "split" ? (
      <div class="grid gap-x-16 gap-y-12 items-start md:grid-cols-2 mb-16 md:mb-20">
        <div>
          {eyebrow && (
            <div class:list={["eyebrow mb-[18px]", t.eyebrow]}>
              <img src={decor.src} alt="" aria-hidden="true" style={`transform: rotate(${decor.rot}deg)`} />{eyebrow}
            </div>
          )}
          <Heading class:list={["display text-[clamp(56px,8.6vw,128px)]", t.heading]} set:html={highlight(heading)} />
        </div>
        {html && <div class:list={["rich text-[19px] leading-relaxed self-end", t.body]} set:html={html} />}
      </div>
    ) : (
      <div class="max-w-208">
        {eyebrow && (
          <div class:list={["eyebrow mb-4", t.eyebrow]}>
            <img src={decor.src} alt="" aria-hidden="true" style={`transform: rotate(${decor.rot}deg)`} />{eyebrow}
          </div>
        )}
        {heading && <Heading class:list={["display text-[clamp(48px,7vw,104px)] mb-10", t.heading]} set:html={highlight(heading)} />}
        {html && <div class:list={["rich text-[19px] leading-relaxed max-w-[42em]", t.body]} set:html={html} />}
      </div>
    )}

    {pillars.length > 0 && (
      <div class:list={["border-t-2", t.rule, layout === "stacked" && "mt-16"]}>
        {pillars.map((p, i) => (
          <div class:list={["flex justify-between items-center gap-6 flex-wrap py-[22px]", i < pillars.length - 1 && ["border-b-[1.5px] border-dashed", t.dash]]}>
            <span class:list={["display text-[clamp(40px,5.4vw,80px)] leading-[0.9]", p.accent && "text-coral"]}>{p.title}</span>
            {p.text && <span class:list={["text-[17px] leading-[1.45] w-[min(100%,290px)]", t.muted]}>{p.text}</span>}
          </div>
        ))}
      </div>
    )}
  </div>
</section>
