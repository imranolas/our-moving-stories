---
import { loadQuery } from "../sanity/lib/load-query";
import { highlight } from "../lib/text";
import EventRow from "./EventRow.astro";
import { EVENT_FIELDS, splitEvents, type Event } from "../lib/schedule";

// Re-exported so pages that import these types from here keep working.
export type { Event, Session } from "../lib/schedule";

export type Props = {
  _type: "events";
  _key: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  events?: number;
};

const {
  eyebrow = "What's on",
  title = "Coming up",
  intro = "Free sessions and events across Ealing, soonest first. Open one for the full schedule and how to book.",
  events: limit = 6,
} = Astro.props;

const { data } = await loadQuery<Event[]>({ query: `*[_type == "event"]{ ${EVENT_FIELDS} }`, preview: Astro.locals.preview });
const { upcoming, past } = splitEvents(data ?? []);
const shown = upcoming.slice(0, limit);
---

<section id="whats-on" class="wrap py-20 md:py-24">
  <div class="flex items-end justify-between gap-6 flex-wrap mb-9">
    <div>
      <div class="eyebrow text-grape mb-3.5">
        <img src="/img/leaves/leaf-3.svg" alt="" aria-hidden="true" style="transform: rotate(-25deg)" />{eyebrow}
      </div>
      <h2 class="display text-[clamp(64px,9vw,140px)] leading-[0.82] text-grape" set:html={highlight(title)} />
    </div>
    {intro && <p class="text-[17px] leading-normal max-w-[21em]">{intro}</p>}
  </div>

  <div class="border-t-[3px] border-ink">
    {shown.length > 0 ? (
      shown.map((event) => <EventRow event={event} />)
    ) : (
      <p class="py-8 text-lg border-b-[1.5px] border-ink">
        No dates announced right now. Follow <a href="https://instagram.com/our.movingstories" target="_blank" rel="noopener noreferrer">@our.movingstories</a> or join the newsletter for new sessions.
      </p>
    )}
  </div>

  <div class="flex items-baseline justify-between gap-6 mt-3.5 font-mono text-sm uppercase">
    {past.length > 0 && <span class="tracking-wider">{past.length} past {past.length === 1 ? "event" : "events"}</span>}
    <a href="/events" class="ml-auto inline-block py-3 text-ink hover:text-grape">All events →</a>
  </div>
</section>
