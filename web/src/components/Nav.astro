---
import { loadQuery } from "../sanity/lib/load-query";
import { formatLink, type NavigationItem } from "../sanity/lib/links";

const { data } = await loadQuery<any[]>({
  query: `*[_type == "settings" || _type == "nav"] {
    ...,
    items[] {
      ...,
      navigationItemUrl {
        ...,
        internalLink { ..., reference-> { slug } }
      }
    }
  }`,
  preview: Astro.locals.preview,
});

const settings = data.find((d) => d._type === "settings") ?? {};
const navigation = data.find((d) => d._type === "nav") ?? { items: [] };
const items = ((navigation.items ?? []) as NavigationItem[])
  .map((item) => ({ text: item.text, href: formatLink(item.navigationItemUrl) }))
  .filter((i) => i.href);
---

<header class="sticky top-0 z-100 bg-cream border-b-2 border-ink" x-data="{ open: false }" @keydown.escape.window="open = false">
  <div class="wrap h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center h-full shrink-0" aria-label={settings.title || "Our Moving Stories"}>
      <img src="/img/logo-purple.svg" alt="" class="h-11 md:h-[62px] w-auto block" width="96" height="70" />
    </a>

    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-6 font-mono text-[13px] uppercase">
      {items.map((item) => (
        <a href={item.href} class="text-ink no-underline hover:text-grape">{item.text}</a>
      ))}
      <a href="/#whats-on" class="no-underline whitespace-nowrap bg-grape text-cream px-3.5 py-2 hover:bg-ink hover:text-cream">Join in</a>
    </nav>

    <button
      type="button"
      class="md:hidden font-mono text-xs uppercase border-2 border-ink px-3 py-2 text-ink"
      @click="open = !open"
      :aria-expanded="open"
      aria-controls="mobile-menu"
    >
      <span x-text="open ? 'Close' : 'Menu'">Menu</span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Main navigation"
    class="md:hidden border-t-2 border-ink bg-cream"
    x-show="open"
    x-cloak
    x-transition.opacity
  >
    <ul class="wrap py-4 flex flex-col">
      {items.map((item) => (
        <li class="border-b-[1.5px] border-ink last:border-0">
          <a href={item.href} @click="open = false" class="block py-3 display text-4xl text-ink no-underline hover:text-grape">{item.text}</a>
        </li>
      ))}
      <li class="pt-4">
        <a href="/#whats-on" @click="open = false" class="btn-primary">Join in</a>
      </li>
    </ul>
  </nav>
</header>
