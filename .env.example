# Copy to .env (gitignored); direnv loads it for every package (.envrc).

# Sanity: project and dataset for the site, Studio and scripts. Never point anything at "staging".
SANITY_STUDIO_PROJECT_ID=othhiu7y
SANITY_STUDIO_DATASET=production
# The site Studio's Presentation tool previews. Local: http://localhost:4321. Deploys: https://ourmovingstories.com.
SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
# Google Maps key for Studio's venue map input.
SANITY_STUDIO_GOOGLE_MAPS_API_KEY=

# Eventbrite private token, for `bun run sync:eventbrite` in studio/ (Account Settings → Developer Links → API Keys).
EVENTBRITE_PRIVATE_TOKEN=

# Cloudflare Web Analytics token: set as a GitHub variable for deploys. Leave it empty here, so local
# visits aren't counted; the site leaves the beacon out when it's empty.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
